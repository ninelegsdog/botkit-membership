# Required env vars for botkit-membership (deploy uses --env-file on VPS)
# Copy to /home/algtro/BOTOGRAD_TECH/botkit-membership/.env and fill secrets.
# Names match src/core/config.py — flat names, no prefix.

# Webhook bot: after deploy run `set_webhook` with WEBHOOK_SECRET_TOKEN set.

TELEGRAM_BOT_TOKEN=    # REQUIRED — token from @BotFather
ADMIN_PASSWORD=        # REQUIRED
ADMIN_IDS=             # REQUIRED — comma-separated numeric Telegram user IDs
DATABASE_URL=
REDIS_URL=
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
WEBHOOK_SECRET_TOKEN=
WEBHOOK_URL=
SENTRY_DSN=
METRICS_PORT=
TIMEZONE=
TRIAL_DAYS=
GRACE_DAYS=
THROTTLE_RATE_LIMIT=
THROTTLE_MAX_IDLE=
