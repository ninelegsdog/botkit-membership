# Required env vars for botkit-membership (deploy uses --env-file on VPS)
# Copy to /home/algtro/BOTOGRAD_TECH/botkit-membership/.env and fill secrets.

# WEBHOOK bot: after deploy run `set_webhook` with the secret below set.
#   bookingbot/membership -> BOTKIT__WEBHOOK_SECRET_TOKEN
#   delivery             -> WEBHOOK_SECRET

BOTKIT__BOT_TOKEN=# REQUIRED
BOTKIT__ADMIN_PASSWORD=# REQUIRED
BOTKIT__ADMIN_IDS=# REQUIRED
BOTKIT__DATABASE_URL=
BOTKIT__REDIS_URL=
BOTKIT__YOOKASSA_SHOP_ID=
BOTKIT__YOOKASSA_SECRET_KEY=
BOTKIT__WEBHOOK_SECRET_TOKEN=
BOTKIT__WEBHOOK_URL=
BOTKIT__SENTRY_DSN=
BOTKIT__METRICS_PORT=
BOTKIT__TIMEZONE=
BOTKIT__TRIAL_DAYS=
BOTKIT__GRACE_DAYS=
BOTKIT__THROTTLE_RATE_LIMIT=
BOTKIT__THROTTLE_MAX_IDLE=
